      "bytecode": "",
      "source": "// SPDX-License-Identifier: MIT\npragma solidity 0.8.28;\n\nimport {ILottery} from \"./ILottery.sol\";\n\n/// @title Lottery\n/// @author Jérémie Nagi\n/// @notice Pay a ticket, guess a number from 0 to 9, and win the whole pot if the guess is right.\n/// @custom:ctf Level 3. Goal: win the pot with one ticket. Where does the winning number come from,\n/// and who else can read those values in the same block?\ncontract Lottery is ILottery {\n    uint256 public constant TICKET_PRICE = 0.1 ether;\n    /// @notice Guesses go from 0 to RANGE - 1.\n    uint256 public constant RANGE = 10;\n\n    event Played(address indexed player, uint256 guess, uint256 winningNumber, uint256 prize);\n\n    error WrongTicketPrice();\n    error GuessOutOfRange();\n    error TransferFailed();\n\n    /// @notice Deploys the lottery with the ETH sent as its initial pot.\n    constructor() payable {}\n\n    /// @notice Buys a ticket and draws at once: a right guess wins the whole balance.\n    function play(uint256 guess) external payable override {\n        if (msg.value != TICKET_PRICE) revert WrongTicketPrice();\n        if (guess >= RANGE) revert GuessOutOfRange();\n\n        uint256 winningNumber = _draw(msg.sender);\n        uint256 prize = guess == winningNumber ? address(this).balance : 0;\n        emit Played(msg.sender, guess, winningNumber, prize);\n\n        if (prize > 0) {\n            (bool sent,) = msg.sender.call{value: prize}(\"\");\n            if (!sent) revert TransferFailed();\n        }\n    }\n\n    function _draw(address player) internal view returns (uint256) {\n        return uint256(keccak256(abi.encode(block.prevrandao, block.timestamp, player))) % RANGE;\n    }\n}\n"
    },
