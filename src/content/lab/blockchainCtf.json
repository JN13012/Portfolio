      "bytecode": "",
      "source": "// SPDX-License-Identifier: MIT\npragma solidity 0.8.28;\n\nimport {IVault} from \"./IVault.sol\";\n\n/// @title Vault\n/// @author Jérémie Nagi\n/// @notice Users deposit ETH and withdraw their whole balance at any time.\n/// @custom:ctf Level 1. Goal: empty the vault. In withdraw(), what happens first: the payment or the\n/// balance update? And what can a contract do when it receives ETH?\ncontract Vault is IVault {\n    /// @notice What the vault owes each account.\n    mapping(address account => uint256 amount) public balanceOf;\n\n    event Deposited(address indexed account, uint256 amount);\n    event Withdrawn(address indexed account, uint256 amount);\n\n    error ZeroDeposit();\n    error NothingToWithdraw();\n    error TransferFailed();\n\n    /// @notice Adds the ETH sent to the caller's balance.\n    function deposit() external payable override {\n        if (msg.value == 0) revert ZeroDeposit();\n        balanceOf[msg.sender] += msg.value;\n        emit Deposited(msg.sender, msg.value);\n    }\n\n    /// @notice Sends the caller's whole balance back to them.\n    function withdraw() external override {\n        uint256 amount = balanceOf[msg.sender];\n        if (amount == 0) revert NothingToWithdraw();\n\n        (bool sent,) = msg.sender.call{value: amount}(\"\");\n        if (!sent) revert TransferFailed();\n\n        balanceOf[msg.sender] = 0;\n        emit Withdrawn(msg.sender, amount);\n    }\n}\n"
    },
